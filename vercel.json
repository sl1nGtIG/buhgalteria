{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci && npm run build",
  "functions": {
    "backend/app/main.py": {
      "maxDuration": 60,
      "excludeFiles": "{frontend/node_modules/**,frontend/android/**,frontend/src/**,frontend/public/**,backend/tests/**,deploy/**,data/**}"
    }
  }
}
