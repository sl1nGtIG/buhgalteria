# Код доступа, который вводится в приложении и на сайте. Обязательно задайте на сервере!
APP_TOKEN=придумайте-длинный-код

# Telegram-бот (необязательно). Токен выдаёт @BotFather.
# TELEGRAM_BOT_TOKEN=
# ID чатов через запятую, которым можно присылать чеки (бот подскажет ID по команде /start)
# TELEGRAM_ALLOWED_CHATS=

# Порог уверенности для автоматической фиксации (0..1)
# AUTO_CONFIRM_SCORE=0.85

# Необязательно: распознавание чеков нейросетью Claude на сервере (без ключа чеки читаются
# на устройстве и разбираются встроенным парсером)
# ANTHROPIC_API_KEY=
