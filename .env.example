# Вход через Telegram: токен бота от @BotFather. Первый вошедший станет владельцем.
TELEGRAM_BOT_TOKEN=

# Необязательно: общий код доступа вместо входа через Telegram
# APP_TOKEN=

# Необязательно: ID чатов через запятую, которым можно присылать чеки боту без входа
# TELEGRAM_ALLOWED_CHATS=

# Порог уверенности для автоматической фиксации (0..1)
# AUTO_CONFIRM_SCORE=0.85

# Необязательно: распознавание чеков нейросетью Claude на сервере (без ключа чеки читаются
# на устройстве и разбираются встроенным парсером)
# ANTHROPIC_API_KEY=
